    {
      "id": "quel-delar-restored-story-blade-compulsion",
      "guideId": "quel-delar-restored-guide",
      "title": "The sword draws toward the Halls",
      "narration": "From the frozen forge, Quel’Delar presses its bearer toward the Halls of Reflection. The quest frames this as compulsion: the blade has a will, and its direction leads into the Lich King’s chamber. This direction belongs to the quest’s magic, not any trail blazed by the seeker. In the blue-black hall, the sword’s restoration turns inward. The first danger is no longer whether it can be wielded, but who commands whom.",
      "durationMs": 5500,
      "eventIds": [
        "quel-delar-restored-blade-compulsion-event"
      ],
      "entityIds": [
        "quel-delar"
      ],
      "locationIds": [
        "halls-of-reflection"
      ],
